{
  "name": "shout",
  "interpreter": {
    "command": "python3",
    "args": [
      "shout.py"
    ],
    "relativePaths": true
  },
  "operators": {
    "": {
      "description": "Shout the operand (uppercase)",
      "bracketed": false
    },
    "#": {
      "description": "Shout twice",
      "bracketed": false
    }
  }
}
