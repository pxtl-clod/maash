{
  "name": "echo",
  "interpreter": {
    "command": "python3",
    "args": [
      "echo.py"
    ],
    "relativePaths": true
  },
  "operators": {
    "": {
      "description": "Primary: echo operand back",
      "bracketed": false
    },
    "+": {
      "description": "Upper-case the operand",
      "bracketed": false
    },
    "#": {
      "description": "Bracketed: echo operand in [ ... ]@@ form",
      "bracketed": true
    }
  }
}
